# Red de seguridad: este proyecto debe servirse desde la carpeta /public,
# nunca desde la raíz. Si algún hosting llegara a apuntar el DocumentRoot
# aquí por error, este archivo bloquea el acceso en vez de exponer el
# código fuente, .env, credenciales, etc.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
