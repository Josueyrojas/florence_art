DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=florence_art
DB_USER=root
DB_PASS=

APP_ENV=local
APP_URL=http://localhost:8000

# Poner en "true" SOLO si el hosting tiene un proxy/balanceador de confianza
# delante (Cloudflare, nginx propio, etc.) que reenvía el protocolo real vía
# X-Forwarded-Proto. Si no estás seguro, déjalo en false: algunos hostings
# gratuitos ponen ese header en "https" aunque el sitio sea http, lo que
# rompe el login (la cookie de sesión queda marcada "solo HTTPS" y el
# navegador nunca la reenvía).
TRUST_PROXY_HTTPS=false
